{
  "name": "nomad-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --define \"SERVER_REV:'$(git rev-parse HEAD:./src)'\"",
    "predeploy": "npm run check:privacy && npm run check:assets",
    "check:privacy": "node scripts/check-privacy.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-all.mjs",
    "check:served": "node scripts/check-served.mjs",
    "bundle:vault": "esbuild src/vault-entry.mjs --bundle --format=esm --minify --alias:nostr-tools=./node_modules/nostr-tools --outfile=src/vault-bundle.js",
    "bundle:nostr": "esbuild src/nostr-entry.mjs --bundle --format=esm --minify --outfile=src/nostr-bundle.js",
    "bundle:qrcode": "esbuild src/qrcode-entry.mjs --bundle --platform=browser --format=esm --minify --outfile=src/qrcode-bundle.js",
    "play": "node scripts/play.mjs",
    "preview": "node scripts/serve-preview.mjs",
    "db:init": "node scripts/init-local-db.mjs",
    "db:reset": "wrangler d1 execute nomad --local --command \"DELETE FROM players; DELETE FROM player_items\"",
    "test:gatehouse": "node scripts/test-build-guard.mjs && node scripts/test-gatehouse-roster.mjs",
    "test:reconnect": "node scripts/test-reconnect.mjs",
    "test:catchup": "node scripts/test-catchup.mjs",
    "test:invites": "node scripts/test-invites.mjs",
    "test:combat": "node scripts/test-combat.mjs",
    "test:styles": "node scripts/test-styles.mjs",
    "test:sound": "node scripts/test-world-sound.mjs",
    "test:security": "node scripts/test-security.mjs",
    "test:security:runtime": "node scripts/test-security-runtime.mjs",
    "test:exhaustion": "node --disable-warning=ExperimentalWarning scripts/combat-balance/check.mjs",
    "check:assets": "node scripts/check-deploy-assets.mjs"
  },
  "dependencies": {
    "nostr-tools": "2.24.1",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260918.1",
    "acorn": "8.18.0",
    "esbuild": "0.28.2",
    "miniflare": "5.20260918.0-alpha",
    "typescript": "^5.7.0",
    "wrangler": "4.135.0",
    "ws": "8.21.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
